{
  "name": "callingai-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:landing": "pnpm --filter landing dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build:landing": "pnpm --filter landing build",
    "seed": "pnpm --filter api seed",
    "format:web:prettier": "prettier --write \"apps/web/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\"",
    "check:web:prettier": "prettier --check \"apps/web/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\"",
    "warn:web:prettier": "prettier --check \"apps/web/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\" || true",
    "format:api": "biome check --write --unsafe ./apps/api",
    "format:web": "biome check --write --unsafe ./apps/web",
    "format:landing:prettier": "prettier --write \"apps/landing/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\"",
    "check:landing:prettier": "prettier --check \"apps/landing/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\"",
    "warn:landing:prettier": "prettier --check \"apps/landing/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\" || true",
    "format:landing": "biome check --write --unsafe ./apps/landing",
    "check:api": "biome check --reporter=summary ./apps/api",
    "check:web": "biome check --reporter=summary ./apps/web",
    "check:landing": "biome check --reporter=summary ./apps/landing",
    "dk": "pnpm --filter api drizzle-kit",
    "ba": "pnpm --filter api better-auth"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "lefthook": "^2.1.5",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}
