{
  "name": "callingai-monorepo",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "typescript": "catalog:"
  },
  "private": true,
  "scripts": {
    "dev": "bun run --parallel -F '*' dev",
    "dev:web": "bun run -F web dev",
    "dev:api": "bun run -F api dev",
    "build:web": "bun run -F web build",
    "build:api": "bun run -F api build",
    "seed": "bun run -F api seed",
    "format:web:prettier": "prettier --write \"apps/web/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\"",
    "check:web:prettier": "prettier --check \"apps/web/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\"",
    "warn:web:prettier": "prettier --check \"apps/web/**/*.{js,jsx,ts,tsx,css,md,mdx,json}\" || true",
    "format:api": "biome check --write --unsafe ./apps/api",
    "format:web": "biome check --write --unsafe ./apps/web",
    "check:api": "biome check --reporter=summary ./apps/api",
    "check:web": "biome check --reporter=summary ./apps/web",
    "dk": "bun run -F api dk",
    "email": "bun run -F api email"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "ajv": "^8.18.0",
      "better-auth": "1.6.11",
      "@better-auth/drizzle-adapter": "1.6.11",
      "dayjs": "^1.11.20",
      "elysia": "^1.4.28",
      "@biomejs/biome": "2.4.4",
      "@tailwindcss/vite": "^4.0.1",
      "tailwindcss": "^4.0.1",
      "react": "^19.2.5",
      "react-dom": "^19.2.5",
      "react-router": "^7.0.0",
      "typescript": "~5.9.3",
      "@vitejs/plugin-react": "^5.1.1",
      "vite": "^7.3.1",
      "clsx": "^2.1.1",
      "tailwind-merge": "^3.4.1",
      "@types/bun": "^1.3.12",
      "class-variance-authority": "^0.7.1",
      "lucide-react": "^0.574.0",
      "@radix-ui/react-slot": "^1.2.4",
      "zod": "^4.3.6"
    }
  }
}
