{
  "name": "callingai-monorepo",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "seed": "pnpm --filter api seed",
    "format:api": "biome check --write --unsafe ./apps/api",
    "format:web": "biome check --write --unsafe ./apps/web",
    "check:api": "biome check --reporter=summary ./apps/api",
    "check:web": "biome check --reporter=summary ./apps/web"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "lefthook": "^2.1.1",
    "prisma": "catalog:"
  }
}
