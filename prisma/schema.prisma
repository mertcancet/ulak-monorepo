generator client {
    provider = "prisma-client"
    output   = "../apps/api/src/prisma/generated"
}

datasource db {
    provider = "postgresql"
}

model User {
    id    String  @id @default(uuid(7))
    email String  @unique
    name  String
    posts Post[]
}

model Post {
    id        String  @id @default(uuid(7))
    title     String
    content   String?
    published Boolean @default(false)
    author    User    @relation(fields: [authorId], references: [id])
    authorId  String
}
