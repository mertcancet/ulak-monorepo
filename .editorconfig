root = true

# All files
indent_style = space
insert_final_newline = true
indent_size = 2
tab_width = 2
charset = utf-8
end_of_line = lf

trim_trailing_whitespace = true
# Xml files
[*.{yml,yaml,json,md,html,css,scss}]
indent_size = 2

[*.{js,jsx,ts,tsx}]
indent_size = 2

[Makefile]
indent_style = tab
