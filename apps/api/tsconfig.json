{
  "compilerOptions": {
    "paths": {
      "types/*": ["./src/types/*"],
      "plugins/*": ["./src/plugins/*"],
      "modules/*": ["./src/modules/*"],
      "shared/*": ["./src/shared/*"],
      "@prisma/*": ["./src/prisma/generated/*"],
      "@ulak/shared": ["../../packages/shared/src"]
    },
    "target": "es2021",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["bun-types"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}
