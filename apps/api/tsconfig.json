{
  "compilerOptions": {
    "paths": {
      "~/db": ["./src/db"],
      "~/db/schema/*": ["./src/db/schema/*"],
      "~/types/*": ["./src/types/*"],
      "~/plugins/*": ["./src/plugins/*"],
      "~/modules/*": ["./src/modules/*"],
      "~/shared/*": ["./src/shared/*"],
      "@ulak/shared": ["../../packages/shared/src"]
    },
    "target": "es2021",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["bun-types"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}
